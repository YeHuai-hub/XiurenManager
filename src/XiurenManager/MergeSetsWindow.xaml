<ui:FluentWindow x:Class="XiurenManager.MergeSetsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Width="720"
                 Height="560"
                 MinWidth="620"
                 MinHeight="480"
                 WindowStartupLocation="CenterOwner">
    <Grid Margin="24,20,24,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="合并套图"
                   Foreground="{StaticResource PrimaryTextBrush}"
                   FontSize="24"
                   FontWeight="SemiBold" />
        <TextBlock Grid.Row="1"
                   Margin="0,6,0,0"
                   Foreground="{StaticResource SecondaryTextBrush}"
                   Text="原套图会按下列顺序保留为子目录，不会展开或覆盖其中的文件。" />
        <Grid Grid.Row="2" Margin="0,18,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="合集名称"
                       Margin="0,0,14,0"
                       VerticalAlignment="Center" />
            <ui:TextBox x:Name="TitleEditor"
                        Grid.Column="1"
                        AutomationProperties.Name="合并后的套图名称" />
        </Grid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="44" />
            </Grid.ColumnDefinitions>
            <ListBox x:Name="PartList"
                     BorderBrush="{StaticResource StrokeBrush}"
                     BorderThickness="1"
                     Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="12,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding OrderLabel}"
                                       Foreground="{StaticResource AccentTealBrush}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Item.Title}"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Item.LocalDir}"
                                           Margin="0,3,0,0"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="11"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <ui:Button Width="36"
                           Height="36"
                           Padding="0"
                           ToolTip="向上移动"
                           Icon="{ui:SymbolIcon ArrowUp24}"
                           Click="MoveUp_OnClick" />
                <ui:Button Width="36"
                           Height="36"
                           Margin="0,8,0,0"
                           Padding="0"
                           ToolTip="向下移动"
                           Icon="{ui:SymbolIcon ArrowDown24}"
                           Click="MoveDown_OnClick" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="4" Margin="0,16,0,0">
            <TextBlock x:Name="ValidationText"
                       Foreground="{StaticResource FavoriteCoralBrush}"
                       VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="取消" Click="Cancel_OnClick" />
                <ui:Button Margin="8,0,0,0"
                           Appearance="Primary"
                           Content="确认合并"
                           Icon="{ui:SymbolIcon FolderArrowRight24}"
                           Click="Confirm_OnClick" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
