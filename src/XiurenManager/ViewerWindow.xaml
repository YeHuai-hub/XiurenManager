<ui:FluentWindow x:Class="XiurenManager.ViewerWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:controls="clr-namespace:XiurenManager.Controls"
                 Title="套图浏览"
                 Width="1580"
                 Height="960"
                 MinWidth="960"
                 MinHeight="640"
                 WindowStartupLocation="CenterOwner"
                 Background="{StaticResource MediaCanvasBrush}"
                 PreviewKeyDown="ViewerWindow_OnKeyDown">
    <Grid x:Name="ViewerRoot"
          Focusable="True"
          Background="{StaticResource MediaCanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="HeaderRow" Height="54" />
            <RowDefinition Height="*" />
            <RowDefinition x:Name="FilmstripRow" Height="88" />
            <RowDefinition x:Name="ControlsRow" Height="58" />
        </Grid.RowDefinitions>

        <Grid x:Name="ViewerHeader"
              Margin="16,0"
              Background="Transparent"
              MouseLeftButtonDown="ViewerHeader_OnMouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:Button ToolTip="返回媒体库"
                       Icon="{ui:SymbolIcon ArrowLeft24}"
                       Click="Close_OnClick" />
            <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                <TextBlock x:Name="SetTitle"
                           Foreground="{StaticResource PrimaryTextBrush}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="MediaTitle"
                           Margin="0,3,0,0"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox x:Name="AutoPlayToggle"
                          Margin="0,0,10,0"
                          Content="自动播放"
                          VerticalAlignment="Center"
                          Checked="AutoPlayToggle_OnChecked"
                          Unchecked="AutoPlayToggle_OnUnchecked" />
                <Slider x:Name="AutoPlaySpeed"
                        AutomationProperties.Name="自动播放速度"
                        Width="94"
                        Margin="0,0,8,0"
                        Minimum="0.5"
                        Maximum="30"
                        Value="5"
                        TickFrequency="0.5"
                        IsSnapToTickEnabled="True"
                        VerticalAlignment="Center"
                        ValueChanged="AutoPlaySpeed_OnValueChanged" />
                <TextBlock x:Name="AutoPlaySpeedText"
                           Width="72"
                           Margin="0,0,12,0"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           FontSize="11"
                           VerticalAlignment="Center" />
                <ui:Button Margin="0,0,8,0"
                           ToolTip="打开当前套图目录"
                           Icon="{ui:SymbolIcon FolderOpen24}"
                           Click="OpenSetFolder_OnClick" />
                <ui:Button x:Name="MediaActionsButton"
                           Margin="0,0,8,0"
                           ToolTip="媒体与套图操作"
                           Icon="{ui:SymbolIcon MoreVertical24}"
                           Click="MediaActions_OnClick">
                    <ui:Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="删除当前图片或视频"
                                      Click="DeleteCurrentMedia_OnClick" />
                            <Separator />
                            <MenuItem Header="删除整套写真"
                                      Click="DeleteCurrentSet_OnClick" />
                        </ContextMenu>
                    </ui:Button.ContextMenu>
                </ui:Button>
                <ui:Button Margin="0,0,12,0"
                           Content="标签"
                           Icon="{ui:SymbolIcon Tag24}"
                           ToolTip="管理本套标签"
                           Click="Tags_OnClick" />
                <TextBlock x:Name="ScoreText"
                           Margin="0,0,16,0"
                           Foreground="{StaticResource FavoriteCoralBrush}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <ui:Button AutomationProperties.Name="进入沉浸模式"
                           ToolTip="沉浸模式（F11）"
                           Icon="{ui:SymbolIcon FullScreenMaximize24}"
                           Click="Immersive_OnClick" />
            </StackPanel>
        </Grid>

        <Grid x:Name="ImmersiveHeader"
              Grid.Row="0"
              Background="{StaticResource MediaCanvasBrush}"
              Visibility="Collapsed">
            <ui:Button AutomationProperties.Name="退出沉浸模式"
                       Margin="0,0,12,0"
                       HorizontalAlignment="Right"
                       ToolTip="退出沉浸模式"
                       Icon="{ui:SymbolIcon FullScreenMinimize24}"
                       Click="Immersive_OnClick" />
        </Grid>

        <Grid x:Name="MediaCanvas"
              Grid.Row="1"
              Background="{StaticResource MediaCanvasBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="TagsColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="MediaViewport"
                  Grid.Column="0"
                  Background="{StaticResource MediaCanvasBrush}"
                  MouseLeftButtonDown="MediaCanvas_OnMouseLeftButtonDown">
                <controls:ZoomPanImage x:Name="ImageViewer" />
                <Grid x:Name="VideoHost"
                      Background="#FF0D1115"
                      ClipToBounds="True"
                      Visibility="Collapsed">
                    <Image x:Name="VideoFrame"
                           Stretch="Uniform"
                           SnapsToDevicePixels="True" />
                </Grid>
                <TextBlock x:Name="ViewerMessage"
                           Text="正在载入"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />

                <ui:Button x:Name="CanvasPrevious"
                           Width="46"
                           Height="72"
                           Margin="14"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Opacity="0.72"
                           ToolTip="上一项"
                           Icon="{ui:SymbolIcon ChevronLeft24}"
                           Click="Previous_OnClick" />
                <ui:Button x:Name="CanvasNext"
                           Width="46"
                           Height="72"
                           Margin="14"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Opacity="0.72"
                           ToolTip="下一项"
                           Icon="{ui:SymbolIcon ChevronRight24}"
                           Click="Next_OnClick" />
            </Grid>

            <Border x:Name="TagsPanel"
                    Grid.Column="1"
                    Width="390"
                    Margin="0,14,14,14"
                    Padding="16"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Stretch"
                    Panel.ZIndex="20"
                    Visibility="Collapsed"
                    CornerRadius="6"
                    BorderThickness="1"
                    BorderBrush="{StaticResource StrokeBrush}"
                    Background="{StaticResource SurfaceBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="42" />
                        <RowDefinition Height="42" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="28" />
                        <RowDefinition Height="38" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="本套标签"
                                   Style="{StaticResource SectionTitleStyle}"
                                   VerticalAlignment="Center" />
                        <ui:Button AutomationProperties.Name="关闭标签面板"
                                   Grid.Column="1"
                                   ToolTip="关闭标签"
                                   Icon="{ui:SymbolIcon Dismiss24}"
                                   Click="CloseTags_OnClick" />
                    </Grid>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox x:Name="TagEditor"
                             AutomationProperties.Name="标签输入"
                             Grid.Row="1"
                             PlaceholderText="输入短标签，回车添加"
                             MaxLength="30"
                             KeyDown="TagEditor_OnKeyDown" />
                        <ui:Button AutomationProperties.Name="添加标签"
                                   Grid.Column="1"
                                   Width="36"
                                   Height="32"
                                   Margin="8,0,0,0"
                                   Padding="0"
                                   ToolTip="添加标签"
                                   Icon="{ui:SymbolIcon Add24}"
                                   Click="AddTag_OnClick" />
                    </Grid>
                    <ScrollViewer Grid.Row="2"
                                  Margin="0,10,0,4"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="TagItems">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,7,7"
                                            Padding="9,4,3,4"
                                            CornerRadius="4"
                                            BorderThickness="1"
                                            BorderBrush="{StaticResource StrokeBrush}"
                                            Background="{StaticResource MediaCanvasBrush}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding}"
                                                       MaxWidth="245"
                                                       Foreground="{StaticResource PrimaryTextBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                            <ui:Button Width="24"
                                                       Height="24"
                                                       Margin="5,0,0,0"
                                                       Padding="0"
                                                       Tag="{Binding}"
                                                       ToolTip="删除标签"
                                                       Icon="{ui:SymbolIcon Dismiss24}"
                                                       Click="RemoveTag_OnClick" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock x:Name="TagsStatus"
                               Grid.Row="3"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="11"
                               VerticalAlignment="Center" />
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:Button Grid.Column="1"
                                   Content="清空全部"
                                   Click="ClearTags_OnClick" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <ListBox x:Name="Filmstrip"
                 Grid.Row="2"
                 Margin="14,7"
                 Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                 SelectionChanged="Filmstrip_OnSelectionChanged">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Width="142" Height="58" Margin="2">
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="4" />
                        <StackPanel Margin="9,7">
                            <TextBlock Text="{Binding Type}"
                                       Foreground="{StaticResource AccentTealBrush}"
                                       FontSize="10"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Name}"
                                       Margin="0,4,0,0"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid x:Name="PlaybackControls"
              Grid.Row="3"
              Margin="14,5,14,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <ui:Button ToolTip="上一项"
                           Icon="{ui:SymbolIcon Previous24}"
                           Click="Previous_OnClick" />
                <ui:Button x:Name="PlayPause"
                           Margin="7,0"
                           ToolTip="播放或暂停"
                           Icon="{ui:SymbolIcon Play24}"
                           Click="PlayPause_OnClick" />
                <ui:Button ToolTip="下一项"
                           Icon="{ui:SymbolIcon Next24}"
                           Click="Next_OnClick" />
            </StackPanel>

            <Grid Grid.Column="1" Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="112" />
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="92" />
                </Grid.ColumnDefinitions>
                <Slider x:Name="PositionSlider"
                        VerticalAlignment="Center"
                        Minimum="0"
                        Maximum="1000"
                        PreviewMouseLeftButtonDown="PositionSlider_OnMouseDown"
                        PreviewMouseMove="PositionSlider_OnMouseMove"
                        PreviewMouseLeftButtonUp="PositionSlider_OnMouseUp" />
                <TextBlock x:Name="TimeText"
                           Grid.Column="1"
                           Text="00:00 / 00:00"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center" />
                <ui:SymbolIcon Grid.Column="2"
                               Symbol="Speaker224"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               VerticalAlignment="Center" />
                <Slider x:Name="VolumeSlider"
                        Grid.Column="3"
                        Minimum="0"
                        Maximum="100"
                        Value="80"
                        VerticalAlignment="Center"
                        ValueChanged="VolumeSlider_OnValueChanged" />
            </Grid>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <ui:Button Content="撤销 1" Click="ScoreMinus_OnClick" />
                <ui:Button Margin="8,0,0,0"
                           Appearance="Primary"
                           Content="看完本套  +1"
                           Icon="{ui:SymbolIcon Heart24}"
                           Click="ScorePlus_OnClick" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
