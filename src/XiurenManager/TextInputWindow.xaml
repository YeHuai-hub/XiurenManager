<ui:FluentWindow x:Class="XiurenManager.TextInputWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Width="520"
                 Height="230"
                 MinWidth="420"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner">
    <Grid Margin="24,20,24,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="28" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="PromptText"
                   Foreground="{StaticResource PrimaryTextBrush}"
                   FontSize="14"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap" />
        <ui:TextBox x:Name="ValueEditor"
                    Grid.Row="1"
                    Margin="0,14,0,0"
                    AutomationProperties.Name="新名称"
                    KeyDown="ValueEditor_OnKeyDown" />
        <TextBlock x:Name="ValidationText"
                   Grid.Row="2"
                   Margin="1,5,0,0"
                   Foreground="{StaticResource FavoriteCoralBrush}"
                   FontSize="11" />
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom">
            <ui:Button Content="取消" Click="Cancel_OnClick" />
            <ui:Button Margin="8,0,0,0"
                       Appearance="Primary"
                       Content="确认"
                       Click="Confirm_OnClick" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
