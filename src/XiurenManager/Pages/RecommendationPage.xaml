<Page x:Class="XiurenManager.Pages.RecommendationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      Background="Transparent"
      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
      ScrollViewer.VerticalScrollBarVisibility="Disabled">
    <Grid Margin="26,18,26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="66" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="随机推荐" Style="{StaticResource PageTitleStyle}" />
                <TextBlock x:Name="RecommendationSummary"
                           Margin="1,6,0,0"
                           Text="每次打开应用，遇见一套本地收藏"
                           Style="{StaticResource SecondaryTextStyle}" />
            </StackPanel>
            <ui:Button x:Name="ShuffleButton"
                       Grid.Column="1"
                       Padding="14,0"
                       VerticalAlignment="Top"
                       Content="换一套"
                       Icon="{ui:SymbolIcon ArrowSync24}"
                       Click="Shuffle_OnClick" />
        </Grid>

        <Grid Grid.Row="1"
              Height="460"
              MaxWidth="1000"
              HorizontalAlignment="Center"
              VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.65*" MinWidth="470" />
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="*" MinWidth="280" MaxWidth="370" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource MediaCanvasBrush}"
                    BorderBrush="{StaticResource StrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    ClipToBounds="True">
                <Grid>
                    <Image x:Name="RecommendationCover"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel x:Name="CoverPlaceholder"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <ProgressBar x:Name="CoverProgress"
                                     Width="80"
                                     Height="4"
                                     IsIndeterminate="True" />
                        <TextBlock x:Name="CoverMessage"
                                   Margin="0,14,0,0"
                                   Text="正在挑选"
                                   TextAlignment="Center"
                                   Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="ModelText"
                           Foreground="{StaticResource AccentTealBrush}"
                           FontSize="15"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="TitleText"
                           Grid.Row="1"
                           Margin="0,10,0,0"
                           Foreground="{StaticResource PrimaryTextBrush}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />

                <StackPanel Grid.Row="2" Margin="0,17,0,0">
                    <TextBlock x:Name="MediaText"
                               Style="{StaticResource SecondaryTextStyle}" />
                    <TextBlock x:Name="SizeText"
                               Margin="0,7,0,0"
                               Style="{StaticResource SecondaryTextStyle}" />
                    <TextBlock x:Name="ScoreText"
                               Margin="0,7,0,0"
                               Foreground="{StaticResource FavoriteCoralBrush}"
                               FontWeight="SemiBold" />
                </StackPanel>

                <ItemsControl x:Name="TagItems" Grid.Row="3" Margin="0,16,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,7,7"
                                    Padding="9,4"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource StrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                <TextBlock Text="{Binding}"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="11" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Grid.Row="4" Margin="0,22,0,0">
                    <ui:Button x:Name="WatchButton"
                               Height="42"
                               HorizontalAlignment="Stretch"
                               HorizontalContentAlignment="Center"
                               Content="打开观看"
                               Icon="{ui:SymbolIcon Play24}"
                               Click="Watch_OnClick" />
                    <ui:Button x:Name="OpenFolderButton"
                               Height="38"
                               Margin="0,10,0,0"
                               HorizontalAlignment="Stretch"
                               HorizontalContentAlignment="Center"
                               Appearance="Secondary"
                               Content="打开目录"
                               Icon="{ui:SymbolIcon FolderOpen24}"
                               Click="OpenFolder_OnClick" />
                </StackPanel>
            </Grid>

            <TextBlock x:Name="EmptyMessage"
                       Grid.ColumnSpan="3"
                       Text="媒体库中还没有可推荐的写真"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       FontSize="16"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="Collapsed" />
        </Grid>
    </Grid>
</Page>
