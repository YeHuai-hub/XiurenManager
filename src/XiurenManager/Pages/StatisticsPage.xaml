<Page x:Class="XiurenManager.Pages.StatisticsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Background="Transparent">
    <Grid Margin="26,20,26,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="74" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <StackPanel>
                <TextBlock Text="资源统计" Style="{StaticResource PageTitleStyle}" />
                <TextBlock x:Name="StatisticsSummary" Margin="1,6,0,0" Style="{StaticResource SecondaryTextStyle}" />
            </StackPanel>
            <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Top">
                <ui:Button Content="重新扫描"
                           Icon="{ui:SymbolIcon ArrowSync24}"
                           Click="Rescan_OnClick" />
                <ui:Button Margin="9,0,0,0"
                           Appearance="Primary"
                           Content="查看选中套图"
                           Icon="{ui:SymbolIcon Image24}"
                           Click="OpenSelected_OnClick" />
            </WrapPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <DataGrid x:Name="ModelGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionChanged="ModelGrid_OnSelectionChanged"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      Background="Transparent"
                      Foreground="{StaticResource PrimaryTextBrush}"
                      RowBackground="{StaticResource SurfaceBrush}"
                      AlternatingRowBackground="{StaticResource SurfaceHoverBrush}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="分类/人物" Binding="{Binding DisplayName}" Width="*" />
                    <DataGridTextColumn Header="套数" Binding="{Binding SetCount}" Width="60" />
                    <DataGridTextColumn Header="喜欢值" Binding="{Binding Score}" Width="70" />
                </DataGrid.Columns>
            </DataGrid>
            <DataGrid x:Name="SetGrid"
                      Grid.Column="2"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      MouseDoubleClick="SetGrid_OnMouseDoubleClick"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      Background="Transparent"
                      Foreground="{StaticResource PrimaryTextBrush}"
                      RowBackground="{StaticResource SurfaceBrush}"
                      AlternatingRowBackground="{StaticResource SurfaceHoverBrush}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="套图名称" Binding="{Binding Title}" Width="*" />
                    <DataGridTextColumn Header="图片" Binding="{Binding ImageCount}" Width="65" />
                    <DataGridTextColumn Header="视频" Binding="{Binding VideoCount}" Width="65" />
                    <DataGridTextColumn Header="损坏" Binding="{Binding InvalidVideoCount}" Width="65" />
                    <DataGridTextColumn Header="大小" Binding="{Binding SizeLabel}" Width="95" />
                    <DataGridTextColumn Header="喜欢值" Binding="{Binding Score}" Width="75" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Page>
