<Page x:Class="XiurenManager.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Background="Transparent"
      PreviewMouseWheel="SettingsPage_OnPreviewMouseWheel">
    <ScrollViewer x:Name="SettingsScroller"
                  PanningMode="VerticalOnly"
                  VerticalScrollBarVisibility="Auto">
        <Grid Margin="26,20,26,30" MaxWidth="1080" HorizontalAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition Height="74" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="设置" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="网站地址、下载工具和并发参数保存在 _Tool\config\settings.json。"
                           Margin="1,6,0,0"
                           Style="{StaticResource SecondaryTextStyle}" />
            </StackPanel>

            <TextBlock Grid.Row="1" Text="网站与账号" Style="{StaticResource SectionTitleStyle}" />
            <Grid Grid.Row="2" Margin="0,14,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" MinWidth="220" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="240" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="54" />
                    <RowDefinition Height="54" />
                </Grid.RowDefinitions>
                <TextBlock Text="网站地址" VerticalAlignment="Center" Foreground="{StaticResource PrimaryTextBrush}" />
                <ui:TextBox x:Name="BaseUrl" Grid.Column="1" />
                <TextBlock Grid.Column="3" Text="网站账号" VerticalAlignment="Center" Foreground="{StaticResource PrimaryTextBrush}" />
                <ui:TextBox x:Name="UserName" Grid.Column="4" />
                <TextBlock Grid.Row="1" Text="分类路径" VerticalAlignment="Center" Foreground="{StaticResource PrimaryTextBrush}" />
                <ui:TextBox x:Name="CategoryPath" Grid.Row="1" Grid.Column="1" />
                <TextBlock Grid.Row="1" Grid.Column="3" Text="网站密码" VerticalAlignment="Center" Foreground="{StaticResource PrimaryTextBrush}" />
                <PasswordBox x:Name="Password"
                             Grid.Row="1"
                             Grid.Column="4"
                             Height="34"
                             Padding="8,5"
                             Background="{StaticResource SurfaceBrush}"
                             Foreground="{StaticResource PrimaryTextBrush}"
                             BorderBrush="{StaticResource StrokeBrush}" />
            </Grid>

            <TextBlock Grid.Row="3" Text="本地工具与下载" Style="{StaticResource SectionTitleStyle}" />
            <Grid Grid.Row="4" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="190" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="54" />
                    <RowDefinition Height="54" />
                    <RowDefinition Height="54" />
                    <RowDefinition Height="54" />
                    <RowDefinition Height="54" />
                    <RowDefinition Height="54" />
                    <RowDefinition Height="88" />
                    <RowDefinition Height="64" />
                </Grid.RowDefinitions>

                <TextBlock Text="下载根目录" VerticalAlignment="Center" Foreground="{StaticResource PrimaryTextBrush}" />
                <ui:TextBox x:Name="DownloadRoot" Grid.Column="1" Grid.ColumnSpan="4" />
                <TextBlock Grid.Row="1" Text="BaiduPCS-Go" VerticalAlignment="Center" Foreground="{StaticResource PrimaryTextBrush}" />
                <ui:TextBox x:Name="BaiduPcs" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4" />
                <TextBlock Grid.Row="2" Text="7-Zip" VerticalAlignment="Center" Foreground="{StaticResource PrimaryTextBrush}" />
                <ui:TextBox x:Name="SevenZip" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4" />
                <TextBlock Grid.Row="3" Text="FFprobe" VerticalAlignment="Center" Foreground="{StaticResource PrimaryTextBrush}" />
                <ui:TextBox x:Name="Ffprobe" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="4" />

                <TextBlock Grid.Row="4" Text="资源并发数" VerticalAlignment="Center" Foreground="{StaticResource PrimaryTextBrush}" />
                <ui:TextBox x:Name="Parallelism" Grid.Row="4" Grid.Column="1" Width="120" HorizontalAlignment="Left" />
                <TextBlock Grid.Row="4" Grid.Column="3" Text="单文件线程数" VerticalAlignment="Center" Foreground="{StaticResource PrimaryTextBrush}" />
                <ui:TextBox x:Name="SingleParallelism" Grid.Row="4" Grid.Column="4" Width="120" HorizontalAlignment="Left" />

                <TextBlock Grid.Row="5" Text="低速阈值 KB/s" VerticalAlignment="Center" Foreground="{StaticResource PrimaryTextBrush}" />
                <ui:TextBox x:Name="LowSpeedThreshold" Grid.Row="5" Grid.Column="1" Width="120" HorizontalAlignment="Left" />
                <TextBlock Grid.Row="5" Grid.Column="3" Text="持续秒数" VerticalAlignment="Center" Foreground="{StaticResource PrimaryTextBrush}" />
                <ui:TextBox x:Name="LowSpeedSeconds" Grid.Row="5" Grid.Column="4" Width="120" HorizontalAlignment="Left" />

                <WrapPanel Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="4" VerticalAlignment="Center">
                    <CheckBox x:Name="DeleteArchive" Content="解压成功后删除压缩包" Foreground="{StaticResource PrimaryTextBrush}" />
                    <CheckBox x:Name="SkipCompleted" Margin="24,0,0,0" Content="跳过本地完整资源" Foreground="{StaticResource PrimaryTextBrush}" />
                    <CheckBox x:Name="KeepSidecars" Margin="24,0,0,0" Content="保留附带文件" Foreground="{StaticResource PrimaryTextBrush}" />
                    <CheckBox x:Name="UseProxy" Margin="24,0,0,0" Content="优先系统代理" Foreground="{StaticResource PrimaryTextBrush}" />
                    <CheckBox x:Name="LowSpeedGuard" Margin="24,0,0,0" Content="启用低速重试" Foreground="{StaticResource PrimaryTextBrush}" />
                </WrapPanel>

                <ui:Button Grid.Row="7"
                           Grid.Column="1"
                           Margin="0,14,0,0"
                           VerticalAlignment="Top"
                           HorizontalAlignment="Left"
                           Appearance="Primary"
                           Content="保存设置"
                           Icon="{ui:SymbolIcon Save24}"
                           Click="Save_OnClick" />
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
