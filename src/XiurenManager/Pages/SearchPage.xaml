<Page x:Class="XiurenManager.Pages.SearchPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="26,20,26,28" MaxWidth="1120" HorizontalAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition Height="74" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="搜索下载" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="按主名称与任意数量的别名搜索，所有结果统一保存到主名称目录。"
                           Margin="1,6,0,0"
                           Style="{StaticResource SecondaryTextStyle}" />
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="390" />
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="390" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="72" />
                    <RowDefinition Height="144" />
                </Grid.RowDefinitions>

                <TextBlock Text="主名称" Style="{StaticResource SectionTitleStyle}" />
                <ui:TextBox x:Name="CanonicalName"
                            Grid.Column="1"
                            Height="34"
                            PlaceholderText="例如：杨晨晨" />

                <TextBlock Grid.Column="3"
                           Text="搜索范围"
                           Style="{StaticResource SectionTitleStyle}" />
                <ComboBox x:Name="SearchMode"
                          Grid.Column="4"
                          Height="34"
                          SelectedIndex="0">
                    <ComboBoxItem Content="全站搜索  /?s=内容" Tag="Global" />
                    <ComboBoxItem Content="分类内搜索  /tbgx?s=内容" Tag="Category" />
                </ComboBox>

                <TextBlock Grid.Row="1"
                           Text="别名"
                           Style="{StaticResource SectionTitleStyle}" />
                <ui:TextBox x:Name="Aliases"
                            Grid.Row="1"
                            Grid.Column="1"
                            Grid.ColumnSpan="4"
                            Height="118"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            VerticalContentAlignment="Top"
                            PlaceholderText="一行一个，也可用逗号、分号或竖线分隔；数量不限" />
            </Grid>

            <Expander Grid.Row="2"
                      Margin="0,10,0,0"
                      Header="高级选项"
                      Foreground="{StaticResource PrimaryTextBrush}">
                <Grid Margin="0,14,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="260" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44" />
                        <RowDefinition Height="44" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="最多搜索页数" Style="{StaticResource SectionTitleStyle}" />
                    <ui:TextBox x:Name="PageCount" Grid.Column="1" Text="999" />
                    <TextBlock Grid.Column="3" Text="最大有效资源数" Style="{StaticResource SectionTitleStyle}" />
                    <ui:TextBox x:Name="MaxReady" Grid.Column="4" Text="9999" />
                    <TextBlock Grid.Column="6" Text="分类路径" Style="{StaticResource SectionTitleStyle}" />
                    <ui:TextBox x:Name="CategoryPath" Grid.Column="7" Text="/tbgx" />
                    <TextBlock Grid.Row="1"
                               Grid.ColumnSpan="8"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Text="按模特统一自动分类：确认微密圈则进微密圈，确认 COS 则进 COS；其余栏目、未识别或冲突内容统一进秀人。" />
                </Grid>
            </Expander>

            <StackPanel Grid.Row="3" Margin="0,28,0,0">
                <WrapPanel>
                    <ui:Button Appearance="Primary"
                               Content="搜索并下载"
                               Icon="{ui:SymbolIcon ArrowDownload24}"
                               Click="SearchDownload_OnClick" />
                    <ui:Button Margin="10,0,0,0"
                               Content="仅搜索入库"
                               Icon="{ui:SymbolIcon Search24}"
                               Click="SearchOnly_OnClick" />
                    <ui:Button Margin="10,0,0,0"
                               Content="下载全部就绪项"
                               Icon="{ui:SymbolIcon CloudArrowDown24}"
                               Click="DownloadReady_OnClick" />
                    <ui:Button Margin="10,0,0,0"
                               Content="继续队列"
                               Icon="{ui:SymbolIcon Play24}"
                               Click="Continue_OnClick" />
                    <ui:Button Margin="10,0,0,0"
                               Content="停止当前任务"
                               Icon="{ui:SymbolIcon Stop24}"
                               Click="Stop_OnClick" />
                </WrapPanel>
                <Border Margin="0,24,0,0"
                        Padding="18,14"
                        CornerRadius="6"
                        Background="{StaticResource SurfaceBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="Info24"
                                       Foreground="{StaticResource AccentTealBrush}"
                                       FontSize="20" />
                        <TextBlock x:Name="QueueStatus"
                                   Grid.Column="1"
                                   Margin="12,0,0,0"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
