<Page x:Class="XiurenManager.Pages.TasksPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Background="Transparent">
    <Grid Margin="26,20,26,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="74" />
            <RowDefinition Height="48" />
            <RowDefinition Height="76" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="任务队列" Style="{StaticResource PageTitleStyle}" />
            <TextBlock x:Name="TaskSummary" Margin="1,6,0,0" Style="{StaticResource SecondaryTextStyle}" />
        </StackPanel>
        <WrapPanel Grid.Row="1">
            <ui:Button Appearance="Primary"
                       Content="继续队列"
                       Icon="{ui:SymbolIcon Play24}"
                       Click="Continue_OnClick" />
            <ui:Button Margin="9,0,0,0"
                       Content="停止当前任务"
                       Icon="{ui:SymbolIcon Stop24}"
                       Click="Stop_OnClick" />
            <ui:Button Margin="18,0,0,0"
                       ToolTip="删除选中的任务记录"
                       Icon="{ui:SymbolIcon Delete24}"
                       Click="DeleteSelected_OnClick" />
            <ui:Button Margin="9,0,0,0"
                       Content="清空已结束"
                       ToolTip="清除已完成、失败和已停止的任务记录"
                       Click="ClearCompleted_OnClick" />
            <ui:Button Margin="9,0,0,0"
                       Content="清空全部"
                       Click="ClearAll_OnClick" />
        </WrapPanel>
        <Grid x:Name="DownloadProgressPanel"
              Grid.Row="2"
              Margin="0,2,0,14"
              Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="DownloadProgressTitle"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryTextBrush}" />
                <TextBlock x:Name="DownloadProgressPercent"
                           Grid.Column="1"
                           Foreground="{StaticResource AccentTealBrush}" />
            </Grid>
            <ProgressBar x:Name="DownloadProgressBar"
                         Grid.Row="1"
                         Height="4"
                         VerticalAlignment="Center" />
            <TextBlock x:Name="DownloadProgressDetail"
                       Grid.Row="2"
                       Style="{StaticResource SecondaryTextStyle}" />
        </Grid>
        <DataGrid x:Name="TaskGrid"
                  Grid.Row="3"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  SelectionMode="Extended"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  Background="Transparent"
                  BorderBrush="{StaticResource StrokeBrush}"
                  Foreground="{StaticResource PrimaryTextBrush}"
                  RowBackground="{StaticResource SurfaceBrush}"
                  AlternatingRowBackground="{StaticResource SurfaceHoverBrush}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="150" />
                <DataGridTextColumn Header="任务" Binding="{Binding Label}" Width="230" />
                <DataGridTextColumn Header="下载进度" Binding="{Binding Progress}" Width="250" />
                <DataGridTextColumn Header="搜索名称" Binding="{Binding Target}" Width="150" />
                <DataGridTextColumn Header="别名" Binding="{Binding Aliases}" Width="180" />
                <DataGridTextColumn Header="排除项" Binding="{Binding Exclusions}" Width="180" />
                <DataGridTextColumn Header="开始时间" Binding="{Binding StartedAt}" Width="145" />
                <DataGridTextColumn Header="结束时间" Binding="{Binding FinishedAt}" Width="145" />
                <DataGridTextColumn Header="错误" Binding="{Binding Error}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
