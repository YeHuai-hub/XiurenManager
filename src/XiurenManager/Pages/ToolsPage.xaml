<Page x:Class="XiurenManager.Pages.ToolsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Background="Transparent">
    <Grid Margin="26,20,26,24" MaxWidth="1080" HorizontalAlignment="Left">
        <Grid.RowDefinitions>
            <RowDefinition Height="74" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="清理工具" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="扫描、校验和整理本地媒体，所有操作均跳过 _Tool。"
                       Margin="1,6,0,0"
                       Style="{StaticResource SecondaryTextStyle}" />
        </StackPanel>

        <Border Grid.Row="1" Padding="18" CornerRadius="6" Background="{StaticResource SurfaceBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="更新资源账本与封面" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="扫描原始目录并更新文件清单、本地封面和完整性状态；缺失资源会保留记录。"
                               Margin="0,6,0,0"
                               Style="{StaticResource SecondaryTextStyle}" />
                </StackPanel>
                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                    <ui:Button Content="更新账本"
                               Icon="{ui:SymbolIcon ArrowSync24}"
                               Click="Scan_OnClick" />
                    <ui:Button x:Name="CleanEmptyDirectoriesButton"
                               Margin="8,0,0,0"
                               Content="清理空目录"
                               Icon="{ui:SymbolIcon Delete24}"
                               Click="CleanEmptyDirectories_OnClick" />
                </WrapPanel>
            </Grid>
        </Border>
        <Border Grid.Row="2" Margin="0,12,0,0" Padding="18" CornerRadius="6" Background="{StaticResource SurfaceBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="删除非图片、非视频文件" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="仅清理已有可用媒体套图中的 HTML、TXT、URL 等附带文件；压缩包和断点文件始终保留。"
                               Margin="0,6,0,0"
                               Style="{StaticResource SecondaryTextStyle}" />
                </StackPanel>
                <ui:Button Grid.Column="1" Content="清理文件" Icon="{ui:SymbolIcon Broom24}" Click="Clean_OnClick" />
            </Grid>
        </Border>
        <Border Grid.Row="3" Margin="0,12,0,0" Padding="18" CornerRadius="6" Background="{StaticResource SurfaceBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="检查视频完整性" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="使用 FFprobe 与抽帧检查定位无法播放或仅有文件头的视频，不会删除媒体。"
                               Margin="0,6,0,0"
                               Style="{StaticResource SecondaryTextStyle}" />
                </StackPanel>
                <ui:Button x:Name="CheckVideoButton"
                           Grid.Column="1"
                           Content="检查视频"
                           Icon="{ui:SymbolIcon VideoClip24}"
                           Click="CheckVideos_OnClick" />
            </Grid>
        </Border>
        <Border Grid.Row="4" Margin="0,12,0,0" Padding="18" CornerRadius="6" Background="{StaticResource SurfaceBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="本地 / NAS 存储整理" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock x:Name="MigrationStatus"
                               Text="尚未启动迁移任务"
                               Margin="0,6,0,0"
                               Style="{StaticResource SecondaryTextStyle}" />
                    <TextBlock x:Name="MigrationCapacity"
                               Margin="0,4,0,0"
                               Style="{StaticResource SecondaryTextStyle}" />
                </StackPanel>
                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                    <ui:Button Content="刷新"
                               Icon="{ui:SymbolIcon ArrowSync24}"
                               Click="RefreshMigration_OnClick" />
                    <ui:Button Margin="8,0,0,0"
                               Content="暂停"
                               Icon="{ui:SymbolIcon Pause24}"
                               Click="PauseMigration_OnClick" />
                    <ui:Button Margin="8,0,0,0"
                               Content="继续"
                               Icon="{ui:SymbolIcon Play24}"
                               Click="ResumeMigration_OnClick" />
                    <ui:Button x:Name="RunMigrationButton"
                               Margin="8,0,0,0"
                               Content="立即整理一批"
                               Icon="{ui:SymbolIcon ArrowMove24}"
                               Click="RunMigration_OnClick" />
                    <ui:Button Margin="8,0,0,0"
                               Content="日志"
                               Icon="{ui:SymbolIcon DocumentText24}"
                               Click="OpenMigrationLog_OnClick" />
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
